{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Node",
    // Важно для корректного включения типов сторонней библиотеки в процесс компиляции
    "baseUrl": ".",
    "paths": {
      // Указывает компилятору использовать данную папку в качестве *изначального* корня для импортируемых модулей.
      // Типы могут копироваться сюда автоматически или в ручном режиме
      "*": ["./libs/*"]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
