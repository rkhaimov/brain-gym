{
  "name": "ceramics-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server-build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:types:verify && npm test && npm run build",
    "db:types": "tsx scripts/generate-database-types.ts",
    "db:types:verify": "tsx scripts/generate-database-types.ts --verify",
    "dev": "concurrently --kill-others-on-fail --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "dev:server": "tsx watch src/server/main.ts",
    "format": "oxfmt --write package.json tsconfig.json tsconfig.client.json tsconfig.server.json tsconfig.server-build.json tsconfig.scripts.json .oxlintrc.json .oxfmtrc.json index.html vite.config.ts vitest.config.ts src scripts",
    "format:check": "oxfmt --check package.json tsconfig.json tsconfig.client.json tsconfig.server.json tsconfig.server-build.json tsconfig.scripts.json .oxlintrc.json .oxfmtrc.json index.html vite.config.ts vitest.config.ts src scripts",
    "generate": "npm run generate:proto && npm run db:types",
    "generate:proto": "buf lint && buf generate",
    "lint": "oxlint",
    "test": "vitest run --project server",
    "test:server": "vitest run --project server",
    "test:server:watch": "vitest --project server",
    "typecheck": "tsc -b tsconfig.client.json tsconfig.server.json tsconfig.scripts.json --pretty false"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "async-mutex": "0.5.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "kysely": "0.29.8",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@connectrpc/protoc-gen-connect-query": "2.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "kysely-codegen": "0.20.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
